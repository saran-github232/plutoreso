# ------------------------------------------------------------------
# PlutoReso frontend — PUBLIC environment variables ONLY.
#
# Never place backend secrets here (Razorpay keys, DB URLs, Drive
# credentials, session secrets). Anything prefixed with VITE_ is
# embedded into the public JS bundle. See docs/ENVIRONMENT.md.
# ------------------------------------------------------------------

# Base URL of the backend API (public configuration only).
# Optional locally — the app falls back to http://localhost:4000.
VITE_API_URL=http://localhost:4000
