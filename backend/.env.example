# ------------------------------------------------------------------
# PlutoReso backend — environment variables
#
# Copy this file to `.env` for local development.
# NEVER commit real `.env` files. NEVER put real credentials here.
# Only safe placeholder names live in this file (Master Guide §35).
# ------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port the API listens on
PORT=4000

# Allowed browser origin(s) for CORS (comma-separated list).
# Local Vite dev server default:
CLIENT_ORIGIN=http://localhost:5173
# In production this MUST be the real frontend origin (e.g. https://plutoreso.com).
# It is validated at startup and is REQUIRED when NODE_ENV=production.

# ------------------------------------------------------------------
# Database (Supabase PostgreSQL) — SERVER-ONLY. Never expose to the frontend,
# never commit real values. See docs/ENVIRONMENT.md and docs/DATABASE.md.
# Locally OPTIONAL: the API boots without it and /api/health/db then reports
# { "database": "not_configured" }. REQUIRED in production (startup fails fast).
#
# Supabase gives you a connection string shaped like:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Paste YOUR real value into backend/.env — not into this example file.
# ------------------------------------------------------------------
# DATABASE_URL=

# Default: auto-detect — remote hosts use TLS, localhost does not. true | false
# DATABASE_SSL=

# ------------------------------------------------------------------
# Razorpay payments (Phase 8) — SERVER-ONLY.
# Generate Test Mode keys from Dashboard → Account & Settings → API Keys.
# Key ID is passed to the frontend; Key Secret NEVER is.
# Optional locally (payment endpoints return 503 when unset); REQUIRED in production.
# ------------------------------------------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ------------------------------------------------------------------
# FUTURE PHASES ONLY — placeholders documented for planning.
# Do NOT create or fill these until their phase; do NOT invent values.
# ------------------------------------------------------------------
# SESSION_SECRET=           # Admin session signing secret (Phase 4+)
# BOOTSTRAP_TOKEN=          # One-time admin bootstrap token (Phase 4+)
# GOOGLE_DRIVE_*            # Drive delivery config (Phase 10) — credentials stay server-side
# EMAIL_* / SMTP_*          # Transactional email provider credentials (Phase 12)
